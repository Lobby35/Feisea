COMPOSE_PROJECT_NAME=borsa-de-treball
POSTGRES_IMAGE=postgres:16-bookworm
POSTGRES_DB=borsa_de_treball
POSTGRES_USER=Lobby34
POSTGRES_PASSWORD='replace-with-your-own-password'
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
TZ=UTC

PGADMIN_IMAGE=dpage/pgadmin4:9.18
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD='replace-with-your-own-pgadmin-password'
PGADMIN_DISABLE_POSTFIX=1
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050

PHP_IMAGE=php:8.3-apache-bookworm
COMPOSER_IMAGE=composer:2
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.28-alpine
API_BIND_ADDRESS=127.0.0.1
API_PORT=8001
API_DB_HOST=db
API_DB_PORT=5432
API_DB_SSLMODE=prefer
FRONTEND_API_UPSTREAM=api:80
FRONTEND_PORT=3000
APP_NAME='Borsa de Treball'
APP_ENV=local
APP_DEBUG=false
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
FRONTEND_BIND_ADDRESS=127.0.0.1
APP_URL=http://127.0.0.1:3000
APP_KEY=
